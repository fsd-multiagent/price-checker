{
	# No admin API, as in web/Caddyfile (S-13); a config change restarts the container.
	admin off
	# Only TCP 443 is published, so do not advertise HTTP/3 (QUIC on UDP 443).
	servers {
		protocols h1 h2
	}
	log {
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>remote_port delete
				request>headers delete
				request>uri delete
			}
		}
	}
}

{$SITE_ADDRESS} {
	handle /api/* {
		reverse_proxy backend:8080
	}
	handle {
		reverse_proxy web:8080
	}
}
