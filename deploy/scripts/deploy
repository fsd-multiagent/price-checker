#!/bin/bash
# VM deploy script (story 3.3, ADR 0015, ADR 0018). Installed by `install` as
# /opt/price-checker/bin/deploy and run only through the forced command
# pc-dispatch:  ssh deploy@<fqdn> deploy <git-sha> <fqdn>
#
# stdin: line 1 registry user, line 2 registry token, then a tar holding
# compose.yaml and Caddyfile. The token reaches docker only on stdin
# (--password-stdin), in a temporary DOCKER_CONFIG that is removed on exit,
# and the registry session is logged out right after the pull and on any exit.
#
# Operator files under the config and state directories are never written,
# created or deleted here (AD-9); the state directory is only checked.
set -euo pipefail
umask 027

PC_ROOT="${PC_ROOT:-/opt/price-checker}"
PC_APP_DIR="${PC_APP_DIR:-$PC_ROOT/app}"
REGISTRY="ghcr.io"

usage() {
  echo "usage: deploy <40-hex git sha> <dns name>" >&2
  exit 64
}

[ "$#" -eq 2 ] || usage
sha="$1"
site="$2"
[[ "$sha" =~ ^[0-9a-f]{40}$ ]] || usage
[[ "$site" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]$ ]] || usage
[ "${#site}" -le 253 ] || usage

state_dir="$PC_ROOT/state"
if [ ! -d "$state_dir" ] || [ ! -w "$state_dir" ]; then
  echo "deploy: $state_dir is missing or not writable; the owner runs deploy/scripts/install once" >&2
  exit 1
fi
if [ ! -d "$PC_APP_DIR" ] || [ ! -w "$PC_APP_DIR" ]; then
  echo "deploy: $PC_APP_DIR is missing or not writable; the owner runs deploy/scripts/install once" >&2
  exit 1
fi

registry_user=""
registry_token=""
IFS= read -r registry_user || true
IFS= read -r registry_token || true
if [ -z "$registry_user" ] || [ -z "$registry_token" ]; then
  echo "deploy: stdin must start with the registry user and token lines" >&2
  exit 65
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/pc-deploy.XXXXXX")"
export DOCKER_CONFIG="$work/docker"
mkdir -m 0700 "$DOCKER_CONFIG"
cleanup() {
  docker logout "$REGISTRY" >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT

# Only these two members are extracted; anything else in the tar is ignored.
# They stay in $work/bundle until the pull has passed, so a failed pull leaves
# the app directory in step with the running containers.
bundle="$work/bundle"
mkdir "$bundle"
tar -x -f - -C "$bundle" --no-same-owner compose.yaml Caddyfile
for f in compose.yaml Caddyfile; do
  if [ -L "$bundle/$f" ] || [ ! -f "$bundle/$f" ]; then
    echo "deploy: bundle has no regular file $f" >&2
    exit 65
  fi
done

export IMAGE_TAG="$sha"
export SITE_ADDRESS="$site"
BACKEND_UID="$(id -u)"
BACKEND_GID="$(id -g)"
export BACKEND_UID BACKEND_GID

project=(docker compose --project-name price-checker)
compose=("${project[@]}" --project-directory "$PC_APP_DIR" -f "$PC_APP_DIR/compose.yaml")

printf '%s\n' "$registry_token" | docker login "$REGISTRY" --username "$registry_user" --password-stdin >/dev/null
registry_token=""

"${project[@]}" --project-directory "$bundle" -f "$bundle/compose.yaml" pull
docker logout "$REGISTRY" >/dev/null

# The pull passed: move the bundle into place. A changed Caddyfile is a new
# inode, so the proxy container is recreated to mount it. The marker survives a
# failed `up`, so the next deploy still recreates the proxy.
caddy_pending="$PC_APP_DIR/.caddy-pending"
if [ ! -f "$PC_APP_DIR/Caddyfile" ] || ! cmp -s "$bundle/Caddyfile" "$PC_APP_DIR/Caddyfile"; then
  : >"$caddy_pending"
fi
for f in compose.yaml Caddyfile; do
  install -m 0640 "$bundle/$f" "$PC_APP_DIR/$f.new"
  mv -f "$PC_APP_DIR/$f.new" "$PC_APP_DIR/$f"
done

# --wait fails when a container does not reach running (or healthy) in time.
"${compose[@]}" up -d --remove-orphans --wait --wait-timeout "${PC_WAIT_SECONDS:-120}"
if [ -e "$caddy_pending" ]; then
  "${compose[@]}" up -d --no-deps --force-recreate --wait --wait-timeout "${PC_WAIT_SECONDS:-120}" proxy
  rm -f "$caddy_pending"
fi

# A backend that fails its start checks (Registry ConfigCheck, a bad Block file) can
# look running for a moment and then restart; a restart during the settle time
# fails the deploy.
restarts() {
  docker inspect --format '{{.State.Running}} {{.RestartCount}}' price-checker-backend price-checker-web
}
before="$(restarts)"
sleep "${PC_SETTLE_SECONDS:-20}"
after="$(restarts)"
if [ "$before" != "$after" ] || grep -q '^false' <<<"$after"; then
  echo "deploy: a container restarted or stopped after start (before: $before; after: $after)" >&2
  "${compose[@]}" ps -a >&2 || true
  exit 1
fi
echo "deploy: $IMAGE_TAG is running on $SITE_ADDRESS"
